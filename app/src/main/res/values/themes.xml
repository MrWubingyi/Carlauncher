<resources>
    <style name="Theme.CarLauncher" parent="Base.Theme.CarLauncher" />
    <style name="Base.Theme.CarLauncher" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cockpit_accent</item>
        <item name="colorPrimaryVariant">@color/cockpit_accent_variant</item>
        <item name="colorOnPrimary">@color/cockpit_on_accent</item>
        <item name="colorSecondary">@color/cockpit_accent</item>
        <item name="colorSecondaryVariant">@color/cockpit_accent_variant</item>
        <item name="colorOnSecondary">@color/cockpit_on_accent</item>
        <item name="colorSurface">@color/cockpit_panel_bg</item>
        <item name="colorOnSurface">@color/cockpit_text_primary</item>
        <item name="colorOnBackground">@color/cockpit_text_primary</item>
        <item name="colorError">@color/cockpit_error</item>
        <item name="android:colorBackground">@color/cockpit_background</item>
        <item name="android:windowBackground">@color/cockpit_background</item>
        <item name="android:textColorPrimary">@color/cockpit_text_primary</item>
        <item name="android:textColorSecondary">@color/cockpit_text_secondary</item>
        <item name="android:statusBarColor">@color/cockpit_background</item>
        <!-- Android 24–26 only support light navigation icons. -->
        <item name="android:navigationBarColor">@color/status_offline</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="materialButtonStyle">@style/Widget.CarLauncher.Button</item>
    </style>
    <style name="Widget.CarLauncher.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
