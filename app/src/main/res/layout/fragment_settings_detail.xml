<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp"
    tools:context=".SettingsDetailFragment">

    <TextView
        android:id="@+id/detailTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="32sp"
        android:textStyle="bold"
        tools:text="Display Detail" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/fragment_detail_description"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/themeLabelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/theme_label"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="18sp"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/themeSpinner"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:entries="@array/theme_labels"
        android:spinnerMode="dropdown"
        android:visibility="gone" />

    <Button
        android:id="@+id/detailBackButton"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/back_to_settings_menu" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/welcomeSwitch"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="启用界面提示" />
</LinearLayout>
