<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runs as the test APK's own UID, not inside the instrumented app process. -->
    <application>
        <activity
            android:name="com.zqautomotive.launcher.shareprobe.JsonShareReceiverActivity"
            android:exported="true"
            android:label="JSON Share Probe"
            android:taskAffinity="com.zqautomotive.launcher.test.jsonshare"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
    </application>
</manifest>
