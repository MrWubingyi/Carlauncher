<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Java 源码检查规则；Gradle 限定扫描范围，生成代码和 third_party 不在扫描范围内。 -->
<!-- 检查入口：统一文件编码和违规级别，包含文件级检查与 Java 语法树检查。 -->
<module name="Checker">
    <!-- 按 UTF-8 读取源码；违规以 error 级别报告。 -->
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <!-- 文件末尾保留换行符。 -->
    <module name="NewlineAtEndOfFile"/>
    <!-- 禁止制表符，使用空格缩进。 -->
    <module name="FileTabCharacter"/>
    <!-- 以下规则基于 Java 语法树检查；未显式设置的属性使用规则默认值。 -->
    <module name="TreeWalker">
        <!-- 禁止通配符导入，明确列出依赖的类型或静态成员。 -->
        <module name="AvoidStarImport"/>
        <!-- 检查未使用的导入。 -->
        <module name="UnusedImports"/>
        <!-- 检查重复导入、java.lang 导入及同包类型等冗余导入。 -->
        <module name="RedundantImport"/>
        <!-- 类型名称使用大驼峰命名，如 VehicleState。 -->
        <module name="TypeName"/>
        <!-- 方法名称使用小驼峰命名，如 updateState。 -->
        <module name="MethodName"/>
        <!-- 参数名称使用小驼峰命名。 -->
        <module name="ParameterName"/>
        <!-- 局部变量名称使用小驼峰命名。 -->
        <module name="LocalVariableName"/>
        <!-- 实例字段名称使用小驼峰命名。 -->
        <module name="MemberName"/>
        <!-- 条件和循环语句使用大括号，避免修改时产生控制流歧义。 -->
        <module name="NeedBraces"/>
        <!-- 禁止多余分号形成的空语句。 -->
        <module name="EmptyStatement"/>
        <!-- 一行只写一条语句。 -->
        <module name="OneStatementPerLine"/>
        <!-- 覆盖 equals 或 hashCode 时须同时覆盖另一方法。 -->
        <module name="EqualsHashCode"/>
    </module>
</module>
