<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cockpitRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cockpit_background"
    tools:context=".MainActivity">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextClock
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="24dp"
            android:gravity="center_vertical"
            tools:text="09:30"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/cockpit_title"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sourceStatusText"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/state_stopped"
            android:textColor="@color/cockpit_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/connectionStatusText"
            android:layout_width="190dp"
            android:layout_height="40dp"
            android:background="@color/status_connecting"
            android:gravity="center"
            android:maxLines="2"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="11sp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeStepGranularity="1sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/service_unbound"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/cockpit_accent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/start_receive"
            android:textAllCaps="false"
            android:textColor="@color/cockpit_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 三栏主体 -->
    <LinearLayout
        android:id="@+id/contentRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- 左栏：车辆状态 -->
        <LinearLayout
            android:id="@+id/vehicleStatusPanel"
            android:layout_width="340dp"
            android:layout_height="match_parent"
            android:background="@color/cockpit_panel_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_status"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/gear_label"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/gearText"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:text="-"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="42sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rpm_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/rpmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- rpm"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/soc_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/batteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textColor="@color/cockpit_positive"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ev_battery_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/evBatteryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textColor="@color/cockpit_positive"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/coolant_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/coolantTempText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@color/cockpit_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/door_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/doorLockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/parking_brake_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/parkingBrakeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/turn_signal_label"
                    android:textColor="@color/cockpit_text_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/turnSignalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <!-- 中栏：核心仪表和告警 -->
        <LinearLayout
            android:id="@+id/dashboardPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/cockpit_panel_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/current_speed"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedText"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:gravity="center"
                android:text="-- km/h"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="72sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/warning_label"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/warningText"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/state_no_data"
                android:textColor="@color/cockpit_warning"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@color/cockpit_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/validity_label"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/validityText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/state_invalid"
                        android:textColor="@color/cockpit_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sequence_label"
                        android:textColor="@color/cockpit_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sequenceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/sequence_empty"
                        android:textColor="@color/cockpit_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/lastUpdateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/waiting_vehicle_data"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <Space
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <!-- 右栏：快捷功能与诊断 -->
        <LinearLayout
            android:id="@+id/quickActionsPanel"
            android:layout_width="330dp"
            android:layout_height="match_parent"
            android:background="@color/cockpit_panel_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_actions"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/navigationButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/navigation"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/mediaButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/media"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/phoneButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/phone"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/appsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/apps"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/vehicleButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/vehicle"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/settingsButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/settings"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/boardButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/board"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/databaseButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="@color/cockpit_action_bg"
                    android:text="@string/database"
                    android:textAllCaps="false"
                    android:textColor="@color/cockpit_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="@color/cockpit_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/communication"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/transportStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/transport_stopped"
                android:textColor="@color/cockpit_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/diagnosticText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/diagnostic_endpoint"
                android:textColor="@color/cockpit_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
